ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# 远端和本地必须设置为同一个至少 32 字符的随机密钥
ARTICLE_SYNC_SECRET=replace-with-a-different-long-random-secret
# 默认禁止同步到本机和内网地址；仅限可信内网部署时才启用
# ARTICLE_SYNC_ALLOW_PRIVATE=true
# 仅在本地内容服务配置上传凭证；请使用只允许写入目标前缀的 RAM 用户或 STS 凭证
OSS_ACCESS_KEY_ID=replace-with-a-ram-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-a-ram-access-key-secret
OSS_BUCKET=replace-with-your-public-read-bucket
# V4 签名需要 Bucket 所在地域，例如杭州为 oss-cn-hangzhou
OSS_REGION=oss-cn-hangzhou
# 传输加速 Endpoint 不包含 Bucket 名称
OSS_ENDPOINT=https://oss-accelerate.aliyuncs.com
OSS_ARTICLE_IMAGE_PREFIX=article-images
# 使用自定义 CDN 域名时设置；否则默认使用 https://<bucket>.oss-accelerate.aliyuncs.com
# OSS_PUBLIC_BASE_URL=https://images.example.com
# LOCATION_DB_PATH=/var/www/wangs/data/wangs.sqlite
NEXT_PUBLIC_SITE_URL=https://news.osfeng.cn
