ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# 远端和本地必须设置为同一个至少 32 字符的随机密钥
ARTICLE_SYNC_SECRET=replace-with-a-different-long-random-secret
# 默认禁止同步到本机和内网地址；仅限可信内网部署时才启用
# ARTICLE_SYNC_ALLOW_PRIVATE=true
# LOCATION_DB_PATH=/var/www/wangs/data/wangs.sqlite
