  ADMIN_PASSWORD=your-admin-password
  ADMIN_SESSION_SECRET=replace-with-a-random-session-secret-at-least-32-characters
  LOCATION_DB_PATH=/var/www/wangs/data/wangs.sqlite
  LOCATION_DEBUG_LOGS=true
  AMAP_WEB_SERVICE_KEY=your-amap-web-service-key
  ARTICLE_VISITOR_IP_HEADER=x-real-ip
  ARTICLE_SYNC_SECRET=replace-with-a-shared-sync-secret-at-least-32-characters
  NEXT_PUBLIC_SITE_URL=https://news.osfeng.cn
  OSS_ACCESS_KEY_ID=your-oss-access-key-id
  OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
  OSS_BUCKET=wangsbucket
  OSS_REGION=oss-cn-beijing
  OSS_ENDPOINT=https://oss-accelerate.aliyuncs.com
  OSS_ARTICLE_IMAGE_PREFIX=article-images
  # 视频库使用独立目录；展示端需配置相同前缀和公共访问基址。
  OSS_ARTICLE_VIDEO_PREFIX=article-videos
  WECHAT_APP_ID=wx0b9c8bf623ce0ecb
  WECHAT_APP_SECRET=your-wechat-app-secret
# Private videos (generate real keys with node scripts/setup-private-video-keys.mjs)
# Each deployment must use its OWN keys. Do not copy real values into this file.
PRIVATE_VIDEO_UPLOAD_ENABLED=false
PRIVATE_VIDEO_MASTER_KEY=
PRIVATE_VIDEO_SYNC_PRIVATE_KEY=
PRIVATE_VIDEO_OSS_PREFIX=private-videos
